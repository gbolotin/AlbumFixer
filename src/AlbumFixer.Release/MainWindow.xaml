<Window x:Class="AlbumFixer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Album Fixer" Width="1300" Height="840" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="#0E151D" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource MintDark}" Margin="0,0,13,0"><TextBlock Text="♫" Foreground="{StaticResource Mint}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Album Fixer" FontWeight="SemiBold" FontSize="20"/><TextBlock Text="Verified library repair · every album is a transaction" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#17242D" CornerRadius="12" Padding="10,5" Margin="0,0,10,0"><TextBlock Text="ALBUM-FIXER SKILL" Foreground="{StaticResource Mint}" FontSize="10" FontWeight="Bold"/></Border><Button Content="Open album" Command="{Binding OpenAlbumCommand}" Style="{StaticResource ButtonStyle}" Padding="12,7"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,13"><StackPanel><TextBlock Text="ALBUM FOLDER" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding AlbumPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBrowse}"/><Button Grid.Column="1" Content="Browse" Click="Browse_Click" IsEnabled="{Binding CanBrowse}" Style="{StaticResource ButtonStyle}" Margin="7,0,0,0" Padding="11,8"/></Grid><Button Content="Scan album" Command="{Binding ScanCommand}" Style="{StaticResource ButtonStyle}" Margin="0,9,0,0"/><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,13,0,0"><StackPanel><TextBlock Text="{Binding AlbumName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Workflow}" Foreground="{StaticResource Mint}" Margin="0,3,0,0"/><TextBlock Text="{Binding Inventory}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock Text="{Binding SourceSize, StringFormat=Source material: {0}}" Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,13"><StackPanel><TextBlock Text="PREFLIGHT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,10,0"/></StackPanel><Border Grid.Column="1" Background="#0F1A21" CornerRadius="8" Padding="8,3" VerticalAlignment="Top"><TextBlock Text="{Binding State}" Foreground="{StaticResource Mint}" FontSize="9" FontWeight="Bold"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="SOURCE POLICY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/><CheckBox Content="Delete verified originals after final pass" IsChecked="{Binding DeleteOriginals}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/><TextBlock Text="Only the exact inventoried source becomes eligible after local, copy-back, final-path, and report gates pass. Any failure keeps it." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="21,7,0,13"/><Button Content="Start safe run" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Cancel run" Command="{Binding CancelCommand}" Style="{StaticResource ButtonStyle}" Margin="0,7,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="13"/><RowDefinition Height="Auto"/><RowDefinition Height="13"/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource MintDark}"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:0}%}" Foreground="{StaticResource Mint}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="PROGRESS" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding StatusTitle}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" MaxHeight="44"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="7"/></StackPanel></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="13"><ItemsControl ItemsSource="{Binding Timeline}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="21" Height="21" CornerRadius="11" Background="{StaticResource MintDark}"><TextBlock Text="{Binding NumberText}" FontSize="9" Foreground="{StaticResource Mint}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="{Binding Title}" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0"><TabControl Background="Transparent" BorderThickness="0">
          <TabItem Header="Inventory"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Detected media and preserved sidecars" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><ListBox Grid.Row="1" ItemsSource="{Binding Media}"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource Mint}"/><TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="{Binding Note}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
          <TabItem Header="Report"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ReportHeadline}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding ReportDetail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,16,0"/></StackPanel><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshReportCommand}" Style="{StaticResource ButtonStyle}" Padding="11,7" Margin="0,0,7,0"/><Button Grid.Column="2" Content="Copy JSON" Command="{Binding CopyReportCommand}" Style="{StaticResource ButtonStyle}" Padding="11,7"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,13"><Border Background="#101923" CornerRadius="7" Padding="10,6" Margin="0,0,7,0"><TextBlock Text="{Binding ReportStatus, StringFormat=Status  {0}}"/></Border><Border Background="#101923" CornerRadius="7" Padding="10,6" Margin="0,0,7,0"><TextBlock Text="{Binding ReportTracks, StringFormat=Tracks  {0}}"/></Border><Border Background="#101923" CornerRadius="7" Padding="10,6" Margin="0,0,7,0"><TextBlock Text="{Binding ReportSections, StringFormat=Discs / areas  {0}}"/></Border><Border Background="#101923" CornerRadius="7" Padding="10,6"><TextBlock Text="{Binding ReportDisposition, StringFormat=Originals  {0}}"/></Border></StackPanel><TextBox Grid.Row="2" Text="{Binding ReportJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
          <TabItem Header="Activity"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Live activity" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><ListBox Grid.Row="1" ItemsSource="{Binding Activity}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource Mint}" FontSize="10" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
        </TabControl></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
