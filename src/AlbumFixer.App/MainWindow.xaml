<Window x:Class="AlbumFixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:AlbumFixer.App"
        xmlns:views="clr-namespace:AlbumFixer.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=app:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1300"
        Height="840"
        MinWidth="1040"
        MinHeight="680"
        Icon="Assets/AlbumFixer.ico"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Window.Resources>
    <DataTemplate DataType="{x:Type app:InventoryViewModel}"><views:InventoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type app:ReportViewModel}"><views:ReportView /></DataTemplate>
    <DataTemplate DataType="{x:Type app:ActivityViewModel}"><views:ActivityView /></DataTemplate>
  </Window.Resources>
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border Background="#0E151D" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40"
                  Height="40"
                  CornerRadius="10"
                  Background="{StaticResource MintDark}"
                  Margin="0,0,13,0">
            <TextBlock Text="♫"
                       Foreground="{StaticResource Mint}"
                       FontSize="23"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Album Fixer" FontWeight="SemiBold" FontSize="20" />
            <TextBlock Text="Verified library repair · every album is a transaction"
                       Foreground="{StaticResource Muted}"
                       FontSize="12" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1"
                Background="#17242D"
                CornerRadius="12"
                Padding="10,5"
                VerticalAlignment="Center">
          <TextBlock Text="ALBUM-FIXER SKILL"
                     Foreground="{StaticResource Mint}"
                     FontSize="10"
                     FontWeight="Bold" />
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <views:SourcesView />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="13" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <views:RunStatusView />
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
          <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Albums">
              <views:AlbumsView />
            </TabItem>
            <TabItem Header="Preflight">
              <views:PreflightView />
            </TabItem>
            <TabItem Header="Inventory" Content="{Binding MediaInventory}" />
            <TabItem Header="Report" Content="{Binding Report}" />
            <TabItem Header="Activity" Content="{Binding Activity}" />
          </TabControl>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
