<UserControl x:Class="AlbumFixer.App.Views.AlbumsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:AlbumFixer.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=app:MainViewModel}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Text="Albums"
               FontSize="15"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource StatusRowTemplate}" />
    </ScrollViewer>
  </Grid>
</UserControl>
