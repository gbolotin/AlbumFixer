<UserControl x:Class="AlbumFixer.App.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:AlbumFixer.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=app:ActivityViewModel}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Text="Live activity" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Items}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="96" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!-- Tabular figures keep the times aligned without a monospaced font. -->
            <TextBlock Text="{Binding Time}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Typography.NumeralAlignment="Tabular" />
            <TextBlock Grid.Column="1" Text="{Binding Kind}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                  <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="NOTICE">
                      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="WARNING">
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="ERROR">
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
