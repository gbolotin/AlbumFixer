<UserControl x:Class="AlbumFixer.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:AlbumFixer.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=app:ReportViewModel}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Headline}" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock Text="{Binding Detail}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,16,0" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              VerticalAlignment="Top"
              Margin="0,0,8,0" />
      <Button Grid.Column="2"
              Content="Copy JSON"
              Command="{Binding CopyCommand}"
              VerticalAlignment="Top" />
      <TextBlock Grid.Column="3" Margin="12,8,0,0">
        <Hyperlink Command="{Binding OpenLogsFolderCommand}" ToolTip="{Binding LogsFolder}">Open logs folder</Hyperlink>
      </TextBlock>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12">
      <Border Style="{StaticResource FactChipStyle}">
        <TextBlock Text="{Binding Status, StringFormat=Status  {0}}" />
      </Border>
      <Border Style="{StaticResource FactChipStyle}">
        <TextBlock Text="{Binding Tracks, StringFormat=Tracks  {0}}" />
      </Border>
      <Border Style="{StaticResource FactChipStyle}">
        <TextBlock Text="{Binding Sections, StringFormat=Discs / areas  {0}}" />
      </Border>
      <Border Style="{StaticResource FactChipStyle}" Margin="0">
        <TextBlock Text="{Binding Disposition, StringFormat=Originals  {0}}" />
      </Border>
    </StackPanel>
    <!-- Monospaced, so the JSON's indentation lines up (allowlisted in xaml-design-allowlist.txt). -->
    <TextBox Grid.Row="2"
             Text="{Binding Json, Mode=OneWay}"
             IsReadOnly="True"
             FontFamily="Cascadia Mono, Consolas"
             FontSize="{DynamicResource CaptionTextBlockFontSize}"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             AutomationProperties.Name="Report JSON" />
  </Grid>
</UserControl>
