<UserControl x:Class="AlbumFixer.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:AlbumFixer.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=app:ReportViewModel}">
  <UserControl.Resources>
    <Style x:Key="ReportFactStyle" TargetType="Border">
      <Setter Property="Background" Value="#101923" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Headline}" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Detail}"
                   Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   Margin="0,3,16,0" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              Style="{StaticResource ButtonStyle}"
              Padding="11,7"
              Margin="0,0,7,0" />
      <Button Grid.Column="2"
              Content="Copy JSON"
              Command="{Binding CopyCommand}"
              Style="{StaticResource ButtonStyle}"
              Padding="11,7" />
      <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
        <Hyperlink Command="{Binding OpenLogsFolderCommand}"
                   ToolTip="{Binding LogsFolder}"
                   Foreground="{StaticResource Mint}">Open logs folder</Hyperlink>
      </TextBlock>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,13">
      <Border Style="{StaticResource ReportFactStyle}">
        <TextBlock Text="{Binding Status, StringFormat=Status  {0}}" />
      </Border>
      <Border Style="{StaticResource ReportFactStyle}">
        <TextBlock Text="{Binding Tracks, StringFormat=Tracks  {0}}" />
      </Border>
      <Border Style="{StaticResource ReportFactStyle}">
        <TextBlock Text="{Binding Sections, StringFormat=Discs / areas  {0}}" />
      </Border>
      <Border Style="{StaticResource ReportFactStyle}" Margin="0">
        <TextBlock Text="{Binding Disposition, StringFormat=Originals  {0}}" />
      </Border>
    </StackPanel>
    <TextBox Grid.Row="2"
             Text="{Binding Json, Mode=OneWay}"
             IsReadOnly="True"
             FontFamily="Cascadia Mono, Consolas"
             FontSize="11"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" />
  </Grid>
</UserControl>
