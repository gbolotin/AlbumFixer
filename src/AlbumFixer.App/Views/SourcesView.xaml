<UserControl x:Class="AlbumFixer.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:AlbumFixer.App"
             xmlns:behaviors="clr-namespace:WpfFoundation.Behaviors;assembly=WpfFoundation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=app:MainViewModel}">
  <!-- The source folders, the scan summary, the run options and Start/Cancel. -->
  <Border Style="{StaticResource CardStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="SOURCE FOLDERS"
                 Foreground="{StaticResource Muted}"
                 FontSize="10"
                 FontWeight="Bold"
                 Margin="0,0,0,9" />
      <Border Grid.Row="1"
              Background="#0E161F"
              BorderBrush="{StaticResource Line}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="9"
              MinHeight="74"
              AllowDrop="True"
              IsEnabled="{Binding CanBrowse}"
              behaviors:FileDrop.Command="{Binding AddDroppedFoldersCommand}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SourceFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#253644" BorderThickness="0,0,0,1" Padding="0,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding}"
                                 ToolTip="{Binding}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                      <Button Grid.Column="1"
                              Command="{Binding DataContext.RemoveSourceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Width="24"
                              Height="24"
                              Padding="4"
                              ToolTip="Remove source folder"
                              AutomationProperties.Name="Remove source folder"
                              Focusable="False">
                        <Button.Style>
                          <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A1D22" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Image Source="/Assets/Remove.png"
                               Width="16"
                               Height="16"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="1"
                     Text="Browse or drag album / parent folders here. Each is scanned recursively."
                     Foreground="{StaticResource Muted}"
                     FontSize="10"
                     Margin="0,7,0,0"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,9,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Content="+ Add"
                Command="{Binding BrowseCommand}"
                Style="{StaticResource ButtonStyle}"
                Padding="11,8" />
        <Button Grid.Column="1"
                Content="Clear"
                Command="{Binding ClearSourceFoldersCommand}"
                Style="{StaticResource ButtonStyle}"
                Margin="7,0,0,0"
                Padding="11,8" />
      </Grid>
      <Button Grid.Row="3"
              Content="Scan albums"
              Command="{Binding ScanCommand}"
              Style="{StaticResource ButtonStyle}"
              Margin="0,9,0,0" />
      <Border Grid.Row="4"
              BorderBrush="{StaticResource Line}"
              BorderThickness="0,1,0,0"
              Margin="0,15,0,0"
              Padding="0,13,0,0">
        <StackPanel>
          <TextBlock Text="{Binding AlbumName}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Workflow}"
                     Foreground="{StaticResource Mint}"
                     Margin="0,3,0,0" />
          <TextBlock Text="{Binding Inventory}"
                     Foreground="{StaticResource Muted}"
                     Margin="0,7,0,0" />
          <TextBlock Text="{Binding SourceSize, StringFormat=Source material: {0}}" Foreground="{StaticResource Muted}" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="5" Margin="0,15,0,0">
        <CheckBox Content="Recheck completed albums"
                  IsChecked="{Binding RecheckCompletedAlbums, Mode=TwoWay}"
                  IsEnabled="{Binding CanBrowse}"
                  Foreground="{StaticResource Text}"
                  FontWeight="SemiBold"
                  ToolTip="Ignore only the previous report's completion status. Read current tags and embedded artwork again, repair missing values only, and preserve existing nonempty tags and artwork. Run Scan albums after changing this option." />
        <TextBlock Text="Valid tags and artwork stay untouched; only genuine gaps are repaired."
                   Foreground="{StaticResource Muted}"
                   FontSize="10"
                   Margin="20,3,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
      <CheckBox Grid.Row="6"
                Content="Delete originals"
                IsChecked="{Binding DeleteOriginals, Mode=TwoWay}"
                IsEnabled="{Binding CanBrowse}"
                Margin="0,12,0,0"
                Foreground="{StaticResource Text}"
                FontWeight="SemiBold"
                ToolTip="When selected, eligible single-image originals are deleted only after final verification. Clear this option to retain every original." />
      <Button Grid.Row="7" Margin="0,10,0,0" VerticalAlignment="Center">
        <Button.Resources>
          <DataTemplate x:Key="StartButtonContentTemplate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 2,1 L 13,7.5 L 2,14 Z"
                    Width="14"
                    Height="14"
                    Stretch="Uniform"
                    Margin="0,0,8,0"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock Text="{Binding}"
                         VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:Key="CancelButtonContentTemplate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 2,2 L 13,13 M 13,2 L 2,13"
                    Width="14"
                    Height="14"
                    Stretch="Uniform"
                    Margin="0,0,8,0"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="2.25"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
              <TextBlock Text="{Binding}"
                         VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </StackPanel>
          </DataTemplate>
        </Button.Resources>
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="Start" />
            <Setter Property="ContentTemplate" Value="{StaticResource StartButtonContentTemplate}" />
            <Setter Property="Command" Value="{Binding StartCommand}" />
            <Setter Property="AutomationProperties.Name" Value="Start" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsRunActive}" Value="True">
                <Setter Property="Content" Value="Cancel" />
                <Setter Property="ContentTemplate" Value="{StaticResource CancelButtonContentTemplate}" />
                <Setter Property="Command" Value="{Binding CancelCommand}" />
                <Setter Property="AutomationProperties.Name" Value="Cancel" />
                <Setter Property="Background" Value="{StaticResource Red}" />
                <Setter Property="Foreground" Value="#2A0808" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </Grid>
  </Border>
</UserControl>
