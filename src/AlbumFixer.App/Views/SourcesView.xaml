<UserControl x:Class="AlbumFixer.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:AlbumFixer.App"
             xmlns:behaviors="clr-namespace:WpfFoundation.Behaviors;assembly=WpfFoundation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=app:MainViewModel}">
  <!-- The source folders, the scan summary, the run options and Start/Cancel. -->
  <Border Style="{StaticResource WfCardStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Source folders" Style="{StaticResource WfLabelTextStyle}" Margin="0,0,0,8" />
      <Border Grid.Row="1"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ControlCornerRadius}"
              Padding="8"
              MinHeight="74"
              AllowDrop="True"
              IsEnabled="{Binding CanBrowse}"
              behaviors:FileDrop.Command="{Binding AddDroppedFoldersCommand}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SourceFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding}"
                                 ToolTip="{Binding}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                      <Button Grid.Column="1"
                              Style="{StaticResource WfTransparentButtonStyle}"
                              Command="{Binding DataContext.RemoveSourceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Padding="4"
                              ToolTip="Remove source folder"
                              AutomationProperties.Name="Remove source folder"
                              Focusable="False">
                        <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource SymbolThemeFontFamily}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="1"
                     Text="Browse or drag album / parent folders here. Each is scanned recursively."
                     Style="{StaticResource SecondaryCaptionTextStyle}"
                     Margin="0,8,0,0" />
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Content="+ Add"
                Command="{Binding BrowseCommand}"
                HorizontalAlignment="Stretch" />
        <Button Grid.Column="1"
                Content="Clear"
                Command="{Binding ClearSourceFoldersCommand}"
                Margin="8,0,0,0" />
      </Grid>
      <Button Grid.Row="3"
              Content="Scan albums"
              Command="{Binding ScanCommand}"
              HorizontalAlignment="Stretch"
              Margin="0,8,0,0" />
      <Border Grid.Row="4"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Margin="0,16,0,0"
              Padding="0,12,0,0">
        <StackPanel>
          <TextBlock Text="{Binding AlbumName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Workflow}"
                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                     Margin="0,4,0,0" />
          <TextBlock Text="{Binding Inventory}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Margin="0,8,0,0" />
          <TextBlock Text="{Binding SourceSize, StringFormat=Source material: {0}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="5" Margin="0,16,0,0">
        <CheckBox Content="Recheck completed albums"
                  IsChecked="{Binding RecheckCompletedAlbums, Mode=TwoWay}"
                  IsEnabled="{Binding CanBrowse}"
                  ToolTip="Ignore only the previous report's completion status. Read current tags and embedded artwork again, repair missing values only, and preserve existing nonempty tags and artwork. Run Scan albums after changing this option." />
        <TextBlock Text="Valid tags and artwork stay untouched; only genuine gaps are repaired."
                   Style="{StaticResource SecondaryCaptionTextStyle}"
                   Margin="32,0,0,0" />
      </StackPanel>
      <CheckBox Grid.Row="6"
                Content="Delete originals"
                IsChecked="{Binding DeleteOriginals, Mode=TwoWay}"
                IsEnabled="{Binding CanBrowse}"
                Margin="0,12,0,0"
                ToolTip="When selected, eligible single-image originals are deleted only after final verification. Clear this option to retain every original." />
      <Grid Grid.Row="7" Margin="0,12,0,0">
        <Grid.Resources>
          <DataTemplate x:Key="IconAndTextTemplate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </Grid.Resources>
        <!-- Start while idle; Cancel replaces it while a run is active. -->
        <Button Content="Start"
                Tag="&#xE768;"
                ContentTemplate="{StaticResource IconAndTextTemplate}"
                Command="{Binding StartCommand}"
                Style="{StaticResource WfPrimaryButtonStyle}"
                HorizontalAlignment="Stretch"
                Visibility="{Binding IsRunActive, Converter={StaticResource WfInverseBooleanToVisibilityConverter}}" />
        <Button Content="Cancel"
                Tag="&#xE711;"
                ContentTemplate="{StaticResource IconAndTextTemplate}"
                Command="{Binding CancelCommand}"
                HorizontalAlignment="Stretch"
                Visibility="{Binding IsRunActive, Converter={StaticResource WfBooleanToVisibilityConverter}}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
