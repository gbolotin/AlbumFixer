<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:AlbumFixer.Core;assembly=AlbumFixer.Core">
  <!-- The state badge on album and preflight rows: Fluent success (passed), caution (warning) and critical (failed)
       colors, bound to the row's RawState. -->
  <Style x:Key="StatusBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Warning}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Failed}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Warning}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Failed}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- A small fact on a subtle fill, as in the Report tab's summary row. -->
  <Style x:Key="FactChipStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- A secondary caption, as under a heading or an option. -->
  <Style x:Key="SecondaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>
