<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One album or preflight check with its state badge; the Albums and Preflight views share it.
       The album name opens the album folder when the row has one. Styles are referenced dynamically because
       they live in sibling dictionaries, which a template in this dictionary cannot see when it loads. -->
  <DataTemplate x:Key="StatusRowTemplate">
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <Grid>
          <TextBlock Text="{Binding Name}"
                     Style="{DynamicResource BodyStrongTextBlockStyle}"
                     Visibility="{Binding AlbumNameTextVisibility}" />
          <TextBlock Style="{DynamicResource BodyStrongTextBlockStyle}"
                     Visibility="{Binding AlbumNameLinkVisibility}"
                     HorizontalAlignment="Left">
            <Hyperlink Command="{Binding DataContext.OpenAlbumFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding AlbumFolderPath}"
                       ToolTip="Open album folder in File Explorer">
              <Run Text="{Binding Name, Mode=OneWay}" />
            </Hyperlink>
          </TextBlock>
        </Grid>
        <TextBlock Text="{Binding Detail}"
                   Style="{DynamicResource SecondaryCaptionTextStyle}"
                   Margin="0,4,12,0" />
      </StackPanel>
      <Border Grid.Column="1" Style="{DynamicResource StatusBadgeStyle}">
        <TextBlock Text="{Binding State}" Style="{DynamicResource StatusBadgeTextStyle}" />
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
