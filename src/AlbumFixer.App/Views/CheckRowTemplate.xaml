<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:AlbumFixer.Core;assembly=AlbumFixer.Core">
  <!-- One album or preflight check with its state badge; the Albums and Preflight views share it.
       The palette lives in App.xaml, outside this dictionary, so it is referenced dynamically. -->
  <DataTemplate x:Key="StatusRowTemplate">
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <Grid>
          <TextBlock Text="{Binding Name}"
                     FontWeight="SemiBold"
                     Visibility="{Binding AlbumNameTextVisibility}" />
          <Button x:Name="AlbumNameLink"
                  Content="{Binding Name}"
                  Command="{Binding DataContext.OpenAlbumFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding AlbumFolderPath}"
                  Visibility="{Binding AlbumNameLinkVisibility}"
                  HorizontalAlignment="Left"
                  ToolTip="Open album folder in File Explorer">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Mint}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>
        <TextBlock Text="{Binding Detail}"
                   Foreground="{DynamicResource Muted}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,2,10,0" />
      </StackPanel>
      <Border Grid.Column="1"
              CornerRadius="8"
              Padding="8,3"
              VerticalAlignment="Top">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="#0F1A21" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Warning}">
                <Setter Property="Background" Value="#3A2B16" />
              </DataTrigger>
              <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Failed}">
                <Setter Property="Background" Value="#3A1D22" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Mint}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Warning}">
                  <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RawState}" Value="{x:Static core:CheckState.Failed}">
                  <Setter Property="Foreground" Value="{DynamicResource Red}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
