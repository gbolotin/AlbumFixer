<Application x:Class="AlbumFixer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System">
  <!-- The Fluent theme follows Windows until AppearanceViewModel applies the remembered System, Light or Dark choice.
       Every color is a Fluent theme brush, so Light, Dark and high contrast all work. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WpfFoundation;component/Themes/WpfFoundation.xaml" />
        <ResourceDictionary Source="/Views/StatusBadges.xaml" />
        <ResourceDictionary Source="/Views/CheckRowTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- List rows use the full width, so their columns line up with the headers above them. -->
      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
