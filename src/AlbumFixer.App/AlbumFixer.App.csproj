<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>AlbumFixer.App</RootNamespace>
    <AssemblyName>Album Fixer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AlbumFixer.ico</ApplicationIcon>
    <SacdExtractSha256>F274F0A3845DBE6DFB2DB168C0C87B15DE3851256A4B5D1A804251BD809BE7B3</SacdExtractSha256>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalWpfFoundation)' == 'true'">
    <ProjectReference Include="$(WpfFoundationProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWpfFoundation)' != 'true'">
    <PackageReference Include="WpfFoundation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlbumFixer.Core\AlbumFixer.Core.csproj" />
    <Resource Include="Assets\AlbumFixer.ico" />
    <None Update="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateBundledSacdExtract" BeforeTargets="Build">
    <GetFileHash Files="$(MSBuildProjectDirectory)\Tools\sacd_extract.exe" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="BundledSacdExtract" />
    </GetFileHash>
    <Error Condition="'%(BundledSacdExtract.FileHash)' != '$(SacdExtractSha256)'"
           Text="The bundled sacd_extract.exe does not match the approved SHA-256." />
  </Target>
</Project>
