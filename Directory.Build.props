<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Application.ThemeMode, which follows the Windows theme, is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <!-- One version for every Album Fixer assembly. Local builds are <VersionPrefix>-dev and CI builds <VersionPrefix>-ci.<run>.
       A vX.Y.Z tag builds and releases X.Y.Z (see .github/workflows/ci.yml); tags are pushed only with Gabi's approval.
       The SDK appends the commit hash to the informational version. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
  </PropertyGroup>
  <!-- AlbumFixer.Local.slnx builds against the WpfFoundation source next to this repository; every other build uses the pinned package.
       Only that solution lists the library project. -p:UseLocalWpfFoundation=true|false overrides. -->
  <PropertyGroup>
    <WpfFoundationProject>$(MSBuildThisFileDirectory)..\WpfFoundation\src\WpfFoundation\WpfFoundation.csproj</WpfFoundationProject>
    <WpfFoundationNotificationsProject>$(MSBuildThisFileDirectory)..\WpfFoundation\src\WpfFoundation.Notifications\WpfFoundation.Notifications.csproj</WpfFoundationNotificationsProject>
    <UseLocalWpfFoundation Condition="'$(UseLocalWpfFoundation)' == '' and '$(SolutionFileName)' == 'AlbumFixer.Local.slnx' and Exists('$(WpfFoundationProject)')">true</UseLocalWpfFoundation>
  </PropertyGroup>
</Project>
